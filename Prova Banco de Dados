-- ==========================================
-- Questão 1: Criação do Banco e Tabelas
-- ==========================================
CREATE DATABASE HOTEL;
USE HOTEL;

CREATE TABLE QUARTOS (
    ID INT PRIMARY KEY AUTO_INCREMENT,
    NUMERO VARCHAR(20),
    CAPACIDADE INT,
    VISTA_MAR BOOLEAN,
    DIARIA DECIMAL(10,2)
);

CREATE TABLE CLIENTES (
    ID INT PRIMARY KEY AUTO_INCREMENT,
    NOME VARCHAR(100),
    EMAIL VARCHAR(100),
    TELEFONE VARCHAR(20)
);

CREATE TABLE RESERVAS (
    ID INT PRIMARY KEY AUTO_INCREMENT,
    CLIENTE_ID INT,
    QUARTO_ID INT,
    DATA_ENTRADA DATE,
    DATA_SAIDA DATE,
    FOREIGN KEY (CLIENTE_ID) REFERENCES CLIENTES(ID),
    FOREIGN KEY (QUARTO_ID) REFERENCES QUARTOS(ID)
);

