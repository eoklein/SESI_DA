-- ==========================================
-- Questão 3: Consultas Básicas
-- ==========================================
-- A:
SELECT * FROM QUARTOS
WHERE VISTA_MAR = TRUE;

-- B:
SELECT NOME, EMAIL FROM CLIENTES;

-- C:
SELECT * FROM QUARTOS
WHERE CAPACIDADE > 2;

-- D:
SELECT * FROM CLIENTES
WHERE NOME LIKE 'B%';

-- E:
SELECT * FROM RESERVAS
WHERE DATA_ENTRADA BETWEEN '2023-05-01' AND '2023-05-31';

-- ==========================================
-- Questão 4: Funções de Agregação
-- ==========================================
-- A:
SELECT COUNT(*) AS TOTAL_QUARTOS
FROM QUARTOS;

-- B:
SELECT * FROM QUARTOS
ORDER BY CAPACIDADE ASC
LIMIT 1;

-- C:
SELECT * FROM QUARTOS
ORDER BY CAPACIDADE DESC
LIMIT 1;

-- D:
SELECT AVG(CAPACIDADE) AS MEDIA_CAPACIDADE
FROM QUARTOS;

-- E:
SELECT COUNT(*) AS TOTAL_VISTA_MAR
FROM QUARTOS
WHERE VISTA_MAR = TRUE;

-- ==========================================
-- Questão 5: Ordenação
-- ==========================================
-- A:
SELECT * FROM QUARTOS
ORDER BY DIARIA DESC;

-- B:
SELECT * FROM QUARTOS
ORDER BY DIARIA ASC;

-- ==========================================
-- Questão 6: Alteração e Atualização
-- ==========================================
-- A:
ALTER TABLE RESERVAS
ADD CUPOM VARCHAR(5);

-- B:
UPDATE RESERVAS
SET CUPOM = 'LGTSP'
WHERE ID = 1;

UPDATE RESERVAS
SET CUPOM = 'XGTSP'
WHERE ID = 2;

UPDATE RESERVAS
SET CUPOM = 'GTSQL'
WHERE ID = 4;

-- ==========================================
-- Questão 7: JOIN entre Reservas e Clientes
-- ==========================================
SELECT *
FROM RESERVAS
INNER JOIN CLIENTES
ON RESERVAS.CLIENTE_ID = CLIENTES.ID;

-- ==========================================
-- Questão 8: JOIN entre Reservas e Quartos
-- ==========================================
SELECT *
FROM RESERVAS
INNER JOIN QUARTOS
ON RESERVAS.QUARTO_ID = QUARTOS.ID;

-- ==========================================
-- Questão 9: Exclusão de Registros
-- ==========================================
DELETE FROM RESERVAS
WHERE ID IN (3, 4);

-- ==========================================
-- Questão 10: Exclusão de Tabelas e Banco
-- ==========================================
DROP TABLE RESERVAS;
DROP TABLE CLIENTES;
DROP TABLE QUARTOS;
DROP DATABASE HOTEL;
